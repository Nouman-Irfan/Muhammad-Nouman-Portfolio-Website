# Create these values in the EmailJS dashboard, then add them to Vercel Environment Variables.
# In the EmailJS template, set the Reply-To field to {{reply_to}}.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
